# ---------------------------------------------------------------------------
# RFP Evaluator configuration
#
# Copy to `.env` and fill in. Every value here can also be overridden from the
# Streamlit sidebar at runtime; this file sets the defaults.
# ---------------------------------------------------------------------------

# Which provider to use: anthropic | openai | fake
#   fake -> returns canned responses, no API key needed. Use it to exercise the
#           full UI and PDF pipeline offline.
LLM_PROVIDER=anthropic

# --- API keys -------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Model selection, per pipeline stage ----------------------------------
# Stage 0 = normalize the RFP questionnaire into canonical questions
# Stage 1 = read one vendor document, extract answers + findings  (the "map")
# Stage 2 = synthesize across all vendor summaries                 (the "reduce")
#
# Stage 1 is the bulk-token stage: it reads whole vendor documents. If cost
# matters more than depth, STAGE1_MODEL=claude-sonnet-5 is the lever to pull.
STAGE0_MODEL=claude-opus-5
STAGE1_MODEL=claude-opus-5
STAGE2_MODEL=claude-opus-5

# OpenAI equivalents, used when LLM_PROVIDER=openai
OPENAI_STAGE0_MODEL=gpt-4o
OPENAI_STAGE1_MODEL=gpt-4o
OPENAI_STAGE2_MODEL=gpt-4o

# --- Generation settings --------------------------------------------------
# Anthropic reasoning effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Max tokens of vendor-document text per Stage 1 call. Documents larger than
# this are split into multiple chunks and merged -- never truncated.
MAX_CHUNK_TOKENS=60000

# Ceiling on generated tokens per call.
MAX_OUTPUT_TOKENS=32000

# --- Pipeline behaviour ---------------------------------------------------
# Include each answer's verbatim source quote in the Stage 2 payload. Off by
# default: quotes are the largest token line item and the appendix already
# preserves them for traceability.
STAGE2_INCLUDE_VERBATIM=false

# Append the raw extracted answers per vendor to the generated PDF.
INCLUDE_APPENDIX=true

# Where run artifacts (per-vendor JSON, synthesis, PDFs) are written.
DATA_DIR=data
